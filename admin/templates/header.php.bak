                <!-- Script para forçar a atualização do layout no carregamento -->
                <script>
                document.addEventListener('DOMContentLoaded', function() {
                    // Forçar a atualização do CSS e evitar problemas de layout
                    if (typeof fixDashboardLayout === 'function') {
                        // Executar imediatamente
                        fixDashboardLayout();
                        
                        // Executar novamente após um curto intervalo para garantir que tudo foi carregado
                        setTimeout(fixDashboardLayout, 100);
                        setTimeout(fixDashboardLayout, 500);
                    }
                    
                    // Adicionar classe para identificar que o layout foi corrigido
                    document.body.classList.add('layout-fixed');
                });
                </script>
            </div>
